# SAOS environment template
# Copy to `.env` and adjust. `.env` is git-ignored — real secrets never enter git.
# Docker Compose reads this file automatically; Node services load it via dotenv.
# Variables are added here as their modules land (each documented when added).

# ── PostgreSQL (docker-compose service: postgres) ──────────────────────────────
# Dev defaults below are safe for local work. In production these are strong
# random values and the Postgres volume sits on an encrypted disk (Hetzner).
POSTGRES_USER=saos
POSTGRES_PASSWORD=saos_dev_password
POSTGRES_DB=saos
POSTGRES_PORT=5432

# Connection string used by migrations, seeds, and services.
# Must match the four values above (host is localhost from your machine,
# `postgres` from inside the compose network).
DATABASE_URL=postgres://saos:saos_dev_password@localhost:5432/saos

# ── MinIO object storage (docker-compose services: minio, minio-init) ─────────
# Holds client documents, delivered returns, signed authorizations, and meeting
# recordings — one private bucket each, created automatically by minio-init.
MINIO_ROOT_USER=saos
MINIO_ROOT_PASSWORD=saos_dev_password
MINIO_PORT=9000          # S3 API
MINIO_CONSOLE_PORT=9001  # Web console (http://localhost:9001)

# ── Application secrets ─────────────────────────────────────────────────────────
# Symmetric key for encrypting SSNs and TOTP secrets at the column level.
# The value below is a WELL-KNOWN DEV KEY (the API refuses it in production).
# For production generate a real one: openssl rand -hex 32
APP_ENCRYPTION_KEY=decade00decade00decade00decade00decade00decade00decade00decade00

# ── API (apps/api) ───────────────────────────────────────────────────────────────
API_PORT=3001
# WISP session timeout: idle window (sliding) capped by an absolute lifetime.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# WISP failed-login lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Client portal auth ──────────────────────────────────────────────────────────
# Magic links are single-use and expire; portal sessions are long-lived.
MAGIC_LINK_TTL_MINUTES=30
PORTAL_SESSION_DAYS=30
# Base URL used to build magic-link URLs (the portal app, M15).
PORTAL_BASE_URL=http://localhost:3000
# Shared secret for the mail delivery-status webhook (bounce fallback).
# Dev value below is refused in production — generate: openssl rand -hex 24
WEBHOOK_SECRET=dev-webhook-secret

# DOCUSEAL_MODE=stub needs no instance (dev/test). For the real container:
# set mode=http, create an API token in the Docuseal admin UI (localhost:3002),
# and configure its webhook to POST /webhooks/docuseal with the shared secret.
DOCUSEAL_MODE=stub
DOCUSEAL_URL=http://localhost:3002
# DOCUSEAL_API_TOKEN=
DOCUSEAL_PORT=3002
# selected (Brian decision, ~$1–3/signature); production refuses remote 8879
# without a real vendor — in-person wet path remains available.

# ── Stripe (payments — approved vendor) ─────────────────────────────────────────
# 'stub' needs no account (dev/test). For real payments: STRIPE_MODE=live with a
# secret key (test mode: sk_test_...) and the webhook signing secret from the
# Stripe dashboard (endpoint: POST /webhooks/stripe).
STRIPE_MODE=stub
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── ntfy push (self-hosted — Brian + Jackson iPhones) ───────────────────────────
# PUSH_MODE=ntfy sends leadership warning/critical alerts to the topic below
# within a minute. Subscribe in the ntfy iPhone app: server http://localhost:8093
# (production: ntfy.sotoaccounting.com behind the reverse proxy), topic saos-alerts.
PUSH_MODE=ntfy
NTFY_URL=http://localhost:8093
NTFY_TOPIC=saos-alerts
NTFY_PORT=8093

# ── Scheduling (Cal.com, profile: booking) ──────────────────────────────────────
# docker compose --profile booking up -d  → admin UI at localhost:3003.
# Configure event types there (two-lane: discovery collects the deposit,
# general inquiries free; Zoom-only on initial consultations) and point its
# webhook at POST /webhooks/calcom with the shared secret. Production values
# must be strong randoms:
CALCOM_PORT=3003
CALCOM_URL=http://localhost:3003
CALCOM_NEXTAUTH_SECRET=dev-calcom-nextauth-secret
CALCOM_ENCRYPTION_KEY=dev-calcom-encryption-key

# ── Meeting intelligence (Whisper + Ollama, profile: intel) ─────────────────────
# stub modes need no containers (dev/test). For the real pipeline:
#   docker compose --profile intel up -d
#   docker compose exec ollama ollama pull llama3.2:3b
# then set TRANSCRIBER_MODE=whisper and SUMMARIZER_MODE=ollama.
# SUMMARIZER_MODE=api is the Claude fallback (cleaned text only — never audio).
TRANSCRIBER_MODE=stub
WHISPER_URL=http://localhost:9010
WHISPER_MODEL=small
SUMMARIZER_MODE=stub
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# ANTHROPIC_API_KEY=

# ── Ops hardening (M21): monitoring, passwords, backups ─────────────────────────
# Uptime Kuma (uptime monitoring UI — first-boot setup + monitor list in
# docs/RUNBOOK_OPS.md) and Vaultwarden (password manager; funder-portal
# credentials migrate in at launch, the shared Sheet gets purged).
UPTIME_KUMA_PORT=3006
VAULTWARDEN_PORT=8094
VAULTWARDEN_DOMAIN=http://localhost:8094
# Admin panel token — leave empty to disable the admin panel entirely.
# Generate for production: openssl rand -base64 48
# VAULTWARDEN_ADMIN_TOKEN=

# Encrypted backups (scripts/backup.sh; restore drill: scripts/restore-drill.sh).
# restic encrypts client-side before upload; Backblaze B2 is the production
# target. RESTIC_PASSWORD is the encryption key — store it in Vaultwarden;
# losing it means losing every backup. BACKUP_STAGING_DIR must be OUTSIDE any
# synced folder (it briefly holds client data in the clear).
# BACKUP_STAGING_DIR=/var/lib/saos/backup-staging
# RESTIC_REPOSITORY=b2:soto-saos-backups:prod
# RESTIC_PASSWORD=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# Where backup.sh drops its machine-readable result (read by the WISP export):
# BACKUP_STATUS_PATH=./backups/status.json

# ── Outbound mail ───────────────────────────────────────────────────────────────
# 'console' prints mail to stdout (dev). 'smtp' relays through the smart host —
# Amazon SES in production (approved vendor; sees routing metadata only).
# Production refuses 'console'.
MAIL_TRANSPORT=console
MAIL_FROM="Soto Accounting <no-reply@sotoaccounting.com>"
# Required when MAIL_TRANSPORT=smtp (SES SMTP credentials, us-east-2 example):
# SMTP_HOST=email-smtp.us-east-2.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
