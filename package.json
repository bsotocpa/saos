{
  "name": "saos",
  "version": "0.1.0",
  "private": true,
  "description": "Soto Accounting Operating System — self-hosted business OS for Soto Accounting LLC + Hilo NFP",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate --workspace=@saos/db",
    "migrate:down": "npm run migrate:down --workspace=@saos/db",
    "seed": "npm run seed --workspace=@saos/db",
    "test": "npm run check:docker-ready && npm run receipt:launched-by-runner && npm run check:sync-root && npm run check:bundle-files && npm run check:ack-identifiers && npm run check:prices && npm run check:sops && npm run check:env-merge && npm run check:role-tasks && npm run check:css-classes && npm run check:form-conditionals && npm run check:sop-steps && npm run check:no-sos-scraping && npm run check:client-sends && npm run check:flash-once && npm run check:date-rendering && npm run check:no-native-dialogs && npm run check:report-files && npm run check:inline-errors && npm run check:task-inserts && npm run check:edit-doors && npm run check:deploy-order && npm run check:test-targets && npm run check:chicago-dates && npm run check:walk-paths && npm run check:absence-waits && npm run check:push-payload && npm run test --workspaces --if-present && node scripts/green-run.mjs record",
    "prepare": "node -e \"if(require('fs').existsSync('scripts/green-run.mjs'))require('child_process').execFileSync(process.execPath,['scripts/green-run.mjs','install-hooks'],{stdio:'inherit'})\"",
    "test:db": "npm run test:db --workspace=@saos/db",
    "check:sync-root": "node scripts/check-sync-root.mjs",
    "check:bundle-files": "node scripts/check-bundle-files.mjs",
    "check:ack-identifiers": "node scripts/check-ack-identifiers.mjs",
    "deploy:preflight": "bash scripts/deploy.sh --preflight-only",
    "check:prices": "node scripts/check-no-hardcoded-prices.mjs",
    "staging:up": "docker compose -p saos-staging -f docker-compose.yml -f docker-compose.staging.yml up -d",
    "staging:down": "docker compose -p saos-staging -f docker-compose.yml -f docker-compose.staging.yml down",
    "import:legacy": "npm run import:legacy --workspace=@saos/api --",
    "check:sops": "node scripts/check-task-sop-hooks.mjs",
    "check:env-merge": "node scripts/check-env-merge.mjs",
    "check:role-tasks": "node scripts/check-role-guarded-tasks.mjs",
    "check:css-classes": "node scripts/check-css-classes.mjs",
    "check:form-conditionals": "node scripts/check-form-conditionals.mjs",
    "check:sop-steps": "node scripts/check-sop-task-alignment.mjs",
    "check:no-sos-scraping": "node scripts/check-no-sos-scraping.mjs",
    "check:client-sends": "node scripts/check-client-send-gates.mjs",
    "check:flash-once": "node scripts/check-flash-once.mjs",
    "check:date-rendering": "node scripts/check-date-rendering.mjs",
    "check:no-native-dialogs": "node scripts/check-no-native-dialogs.mjs",
    "check:report-files": "node scripts/check-report-files.mjs",
    "check:inline-errors": "node scripts/check-inline-errors.mjs",
    "check:task-inserts": "node scripts/check-task-inserts.mjs",
    "check:edit-doors": "node scripts/check-edit-doors.mjs",
    "check:deploy-order": "node scripts/check-deploy-order.mjs",
    "deploy:dry-run": "bash scripts/deploy.sh --preflight-only",
    "check:test-targets": "node --experimental-strip-types apps/api/scripts/check-test-targets.ts",
    "check:docker-ready": "node scripts/check-docker-ready.mjs",
    "check:receipt-runner": "node scripts/check-receipt-runner.mjs",
    "receipt:launched-by-runner": "node scripts/check-receipt-runner.mjs --receipt",
    "check:walk-paths": "node scripts/walk-evidence-reports.mjs --check",
    "check:absence-waits": "node scripts/check-absence-waits.mjs",
    "check:push-payload": "node scripts/check-push-payload.mjs",
    "check:harness-lanes": "node scripts/harness-lanes-check.mjs",
    "check:chicago-dates": "node scripts/check-chicago-dates.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
